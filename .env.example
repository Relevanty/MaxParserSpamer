# Telegram API credentials — get yours at https://my.telegram.org/auth?to=apps
API_ID=
API_HASH=

# Auth method: "qr" (scan with phone, default) or "phone" (enter number + code)
AUTH_METHOD=qr

# Set to "true" to force SMS code delivery instead of in-app code
FORCE_SMS=false

# Session string — generated automatically on first login, do not set manually
SESSION_STRING=

# Discord credentials (only needed for Discord sender / parser)
DISCORD_USER_TOKEN=
DISCORD_GUILD_ID=

# Override send mode at runtime: "instant" or "schedule"
# Defaults to the MODE value in src/config.js
# SEND_MODE=schedule
